{
  "status": 0,
  "message": "success",
  "data": {
    "pageId": "96132910-8814-4328-b4e1-f2a51785da0b",
    "id": 2,
    "projectId": "4",
    "pageTitle": "表单禁用",
    "pageName": "formDisabled",
    "namespace": "联通",
    "pageIcon": "",
    "groupBy": "form",
    "updatedBy": "admin",
    "updatedCause": null,
    "hidden": null,
    "assets": [
    ],
    "visible": null,
    "pageDesc": null,
    "pageSchema": {
      "renderer": "page",
      "classname": "wk-org-page",
      "body": [
        {
          "renderer": "split",
          "panels": [
            {
              "style": {
                "padding-right": "20px"
              },
              "body": [
                {
                  "renderer": "form",
                  "controls": [
                    {
                      "renderer": "tree",
                      "name": "orgCode",
                      "lazy": true,
                      "showCheckbox": false,
                      "joinValue": false,
                      "initApi": {
                        "url": "/v1/ajax/tree",
                        "params": {
                          "code": "${code}"
                        }
                      },
                      "defaultProps": {
                        "isLeaf": "isLeaf",
                        "children": "children"
                      },
                      "nodeKey": "code",
                      "target": "OrgService",
                      "body": [
                        {
                          "renderer": "html",
                          "html": "<%=$.label%>"
                        },
                        {
                          "renderer": "dropdown",
                          "text": "...",
                          "style": {
                            "position": "absolute",
                            "right": "6px"
                          },
                          "body": [
                            {
                              "renderer": "action",
                              "text": "新增平级",
                              "isText": true,
                              "actionType": "extends",
                              "triggered": "delete"
                            },
                            {
                              "renderer": "action",
                              "text": "新增下级",
                              "isText": true,
                              "actionType": "extends",
                              "triggered": "add"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "size": "20%"
            },
            {
              "style": {
                "padding-left": "20px"
              },
              "body": [
                {
                  "renderer": "service",
                  "name": "OrgService",
                  "body": [
                    {
                      "renderer": "render",
                      "body": [
                        {
                          "renderer": "html",
                          "html": "<%=$.orgCode%>",
                          "style": {
                            "display": "inline"
                          }
                        },
                        {
                          "renderer": "action",
                          "text": "保存",
                          "classname": "org-save",
                          "actionType": "trigger",
                          "triggered": "OrgForm"
                        }
                      ]
                    },
                    {
                      "renderer": "form",
                      "name": "OrgForm",
                      "labelPosition": "top",
                      "controls": [
                        {
                          "renderer": "divider",
                          "text": "基础信息"
                        },
                        {
                          "label": "组织机构代码",
                          "requiredOn": true,
                          "rules": [
                            {
                              "pattern": {},
                              "message": "编码规则为 8 位数字流水码",
                              "trigger": "blur"
                            }
                          ],
                          "name": "orgCode",
                          "renderer": "input"
                        },
                        {
                          "label": "组织机构类型",
                          "renderer": "select",
                          "requiredOn": true,
                          "tableName": "cap_meta_org_type",
                          "params": {
                            "cached": true
                          },
                          "name": "orgType"
                        },
                        {
                          "renderer": "radio",
                          "label": "是否虚拟部门",
                          "defaultValue": "1",
                          "options": [
                            {
                              "value": "1",
                              "label": "是"
                            },
                            {
                              "value": "0",
                              "label": "否"
                            }
                          ],
                          "name": "isVirtualDept"
                        },
                        {
                          "label": "组织机构全称",
                          "requiredOn": true,
                          "rules": [
                            {
                              "pattern": {},
                              "message": "仅支持汉字、字母、数字和下划线",
                              "trigger": "blur"
                            }
                          ],
                          "name": "orgFullName",
                          "renderer": "input"
                        },
                        {
                          "label": "组织机构简称",
                          "requiredOn": true,
                          "rules": [
                            {
                              "pattern": {},
                              "message": "仅支持汉字、字母、数字和下划线",
                              "trigger": "blur"
                            }
                          ],
                          "name": "orgShortName",
                          "renderer": "input"
                        },
                        {
                          "label": "企业类型",
                          "renderer": "select",
                          "tableName": "cap_meta_ent_type",
                          "name": "enterpriseType"
                        },
                        {
                          "label": "登记注册类型",
                          "renderer": "select",
                          "tableName": "cap_meta_reg_type",
                          "name": "regType"
                        },
                        {
                          "renderer": "radio",
                          "label": "是否扩展组织",
                          "requiredOn": true,
                          "disabledOn": true,
                          "defaultValue": "1",
                          "options": [
                            {
                              "value": "1",
                              "label": "是"
                            },
                            {
                              "value": "0",
                              "label": "否"
                            }
                          ],
                          "name": "isExtend"
                        },
                        {
                          "renderer": "divider",
                          "direction": "horizontal",
                          "contentPosition": "center",
                          "text": "标识代码"
                        },
                        {
                          "label": "统一社会信用代码",
                          "rules1": [
                            {
                              "pattern": {},
                              "message": "代码不合法",
                              "trigger": "blur"
                            }
                          ],
                          "name": "uscc",
                          "renderer": "input"
                        },
                        {
                          "label": "工商注册登记号",
                          "name": "icRegNo",
                          "renderer": "input"
                        },
                        {
                          "label": "全国组织机构代码",
                          "name": "nOrgCode",
                          "renderer": "input"
                        },
                        {
                          "label": "纳税人登记号",
                          "name": "vatNo",
                          "renderer": "input"
                        },
                        {
                          "label": "其他有效证件号",
                          "name": "otherIdNo",
                          "renderer": "input"
                        },
                        {
                          "renderer": "divider",
                          "direction": "horizontal",
                          "contentPosition": "center",
                          "text": "地理信息"
                        },
                        {
                          "label": "国家",
                          "renderer": "select",
                          "tableName": "cap_meta_country",
                          "params": {
                            "cached": true
                          },
                          "name": "country"
                        },
                        {
                          "renderer": "computed",
                          "name": "province",
                          "exp": "''",
                          "deps": [
                            "country"
                          ]
                        },
                        {
                          "label": "省份/直辖市",
                          "renderer": "select",
                          "tableName": "cap_meta_area",
                          "params": {
                            "cached": true,
                            "queryType": 2,
                            "parentId": "country"
                          },
                          "name": "province"
                        },
                        {
                          "renderer": "computed",
                          "name": "city",
                          "exp": "''",
                          "deps": [
                            "province"
                          ]
                        },
                        {
                          "label": "城市",
                          "renderer": "select",
                          "tableName": "cap_meta_area",
                          "params": {
                            "cached": true,
                            "queryType": 2,
                            "parentId": "province"
                          },
                          "name": "city"
                        },
                        {
                          "renderer": "computed",
                          "name": "town",
                          "exp": "''",
                          "deps": [
                            "city"
                          ]
                        },
                        {
                          "label": "区县",
                          "renderer": "select",
                          "tableName": "cap_meta_area",
                          "params": {
                            "cached": true,
                            "queryType": 2,
                            "parentId": "city"
                          },
                          "name": "town"
                        },
                        {
                          "renderer": "divider",
                          "direction": "horizontal",
                          "contentPosition": "center",
                          "text": "注册信息"
                        },
                        {
                          "label": "法定代表人",
                          "requiredOn": true,
                          "name": "legalRep",
                          "renderer": "input"
                        },
                        {
                          "label": "注册地址",
                          "name": "regAddress",
                          "renderer": "input"
                        },
                        {
                          "label": "邮政编码",
                          "name": "postalCode",
                          "renderer": "input"
                        },
                        {
                          "renderer": "divider",
                          "direction": "horizontal",
                          "contentPosition": "center",
                          "text": "管理信息"
                        },
                        {
                          "label": "上级管理单位",
                          "renderer": "select",
                          "requiredOn": true,
                          "tableName": "cap_meta_upper_unit",
                          "name": "upperMgrUnit"
                        },
                        {
                          "label": "管理组织排序码",
                          "name": "mgrPriox",
                          "renderer": "input"
                        },
                        {
                          "label": "所属直管企业",
                          "renderer": "select",
                          "tableName": "cap_meta_mgmt_ent",
                          "name": "directEnterprise"
                        },
                        {
                          "label": "股权属性",
                          "renderer": "select",
                          "tableName": "cap_meta_equity_type",
                          "name": "equityType"
                        },
                        {
                          "label": "经营状态",
                          "renderer": "select",
                          "tableName": "cap_meta_op_status",
                          "name": "operationStatus"
                        },
                        {
                          "renderer": "divider",
                          "direction": "horizontal",
                          "contentPosition": "center",
                          "text": "人事股权关系"
                        },
                        {
                          "label": "上级人事单位",
                          "requiredOn": true,
                          "renderer": "select",
                          "tableName": "cap_meta_upper_unit",
                          "name": "upperHrUnit"
                        },
                        {
                          "label": "人事组织排序码",
                          "name": "hrPriox",
                          "renderer": "input"
                        },
                        {
                          "label": "上级股权单位",
                          "renderer": "select",
                          "requiredOn": true,
                          "tableName": "cap_meta_upper_unit",
                          "name": "upperEquityUnit"
                        },
                        {
                          "label": "股权组织排序码",
                          "name": "equityPriox",
                          "renderer": "input"
                        },
                        {
                          "label": "股东名称",
                          "name": "stockholderName",
                          "renderer": "input"
                        },
                        {
                          "label": "内外股东标识",
                          "renderer": "select",
                          "tableName": "cap_meta_shr_sign",
                          "name": "stockholderCategory"
                        },
                        {
                          "label": "股东经济类型",
                          "renderer": "select",
                          "tableName": "cap_meta_shr_type",
                          "name": "stockholderType"
                        },
                        {
                          "label": "股东持股比例",
                          "name": "shareholdingRatio",
                          "renderer": "input"
                        }
                      ],
                      "classname": "demo-grid-form"
                    },
                    {
                      "renderer": "divider",
                      "direction": "horizontal",
                      "contentPosition": "left",
                      "text": "业务组织"
                    },
                    {
                      "renderer": "table",
                      "columns": [
                        {
                          "label": "序号",
                          "name": "id",
                          "fixed": "-"
                        },
                        {
                          "label": "组织机构代码",
                          "name": "orgCode",
                          "fixed": "-"
                        },
                        {
                          "label": "组织机构名称",
                          "name": "fullPathName",
                          "fixed": "-"
                        },
                        {
                          "label": "业务组织类型",
                          "name": "bizType",
                          "fixed": "-"
                        },
                        {
                          "name": "createBy",
                          "label": "创建人",
                          "fixed": "-"
                        },
                        {
                          "name": "createAt",
                          "label": "创建时间",
                          "fixed": "-"
                        },
                        {
                          "name": "updateBy",
                          "label": "更新人",
                          "fixed": "-"
                        },
                        {
                          "name": "updateAt",
                          "label": "更新时间",
                          "fixed": "-"
                        },
                        {
                          "fixed": "-",
                          "renderer": "column",
                          "body": [
                            {
                              "renderer": "action"
                            }
                          ],
                          "header": [],
                          "label": "操作"
                        }
                      ],
                      "header": []
                    }
                  ],
                  "initApi": {
                    "url": "/api/mock/org-details",
                    "method": "get",
                    "deep": true,
                    "params": {
                      "orgCode": "${orgCode}"
                    }
                  },
                  "sendOn": "$.orgCode !== ''"
                }
              ],
              "size": "80%"
            }
          ]
        }
      ],
      "innerStyle": ".wk-org-page {\r\n.demo-grid-form {\r\n  .i-form__container__fieldset__items {\r\n    display: grid;\r\n    grid-template-columns: repeat(3, 33.3%);\r\n  }\r\n  .field-1,\r\n  .field-4,\r\n  .field-7,\r\n  .field-10 {\r\n    padding-right: 20px;\r\n  }\r\n  .field-2,\r\n  .field-5,\r\n  .field-8,\r\n  .field-11 {\r\n    padding: 0 10px;\r\n  }\r\n  .field-3,\r\n  .field-6,\r\n  .field-9,\r\n  .field-12 {\r\n    padding-left: 20px;\r\n  }\r\n}\r\n.org-save {\r\n  position: absolute;\r\n  right: 10px;\r\n}\r\n.i-render__container {\r\n  position: sticky;\r\n  top: 0;\r\n  width: 100%;\r\n  height: 46px;\r\n  background: var(--el-color-white);\r\n  z-index: 2;\r\n}\r\n}",
      "style": {
        "height": "100%"
      }
    },
    "version": 0,
    "status": 1,
    "createdAt": "2023-11-25T15:13:53.000Z",
    "updatedAt": "2023-11-27T06:14:44.000Z"
  }
