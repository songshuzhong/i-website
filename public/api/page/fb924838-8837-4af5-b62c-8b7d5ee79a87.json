          "interval": 5000,
          "target": "WalkerChart.dispatchAction"
        }
      ],
      "worker": "e => {\r\n  let { startValue, endValue, direction } = e.data;\r\n  start = Number(startValue);\r\n  end = Number(endValue);\r\n  if (direction) {\r\n    if (end < 6) {\r\n      start += 1\r\n      end += 1\r\n    } else {\r\n      direction = false\r\n    }\r\n  } else {\r\n    if (end > 4) {\r\n      start -= 1\r\n      end -= 1\r\n    } else {\r\n      direction = true\r\n    }\r\n  }\r\n\r\n  return Promise.resolve({\r\n    now: Date.now(),\r\n    endValue: end,\r\n    startValue: start,\r\n    direction,\r\n  });\r\n}"
