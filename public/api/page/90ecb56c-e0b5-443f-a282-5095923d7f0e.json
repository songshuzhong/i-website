    "pageSchema": {
      "renderer": "page",
      "classname": "virus-page",
      "body": [
        {
          "renderer": "html",
          "html": "<h1>2022年12月1日至2023年3月23日全国新型冠状病毒感染疫情情况（MOCK数据）</h1>",
          "classname": "font-size-22 text-center margin-bottom-20"
        },
        {
          "renderer": "service",
          "initApi": {
            "url": "/api/mock/virus/country",
            "method": "get",
            "params": {}
          },
          "body": [
            {
              "renderer": "wrapper",
              "name": "PreviewDate",
              "bodyClassname": "preview-country swing_scale_1",
              "body": [
                {
                  "renderer": "html",
                  "inline": true,
                  "html": "${data.name}",
                  "style": {
                    "marginRight": "6px",
                    "fontSize": "16px",
                    "fontWeight": "bold",
                    "lineHeight": "30px"
                  }
                },
                {
                  "renderer": "tooltip",
                  "content": "${$.comment || '无'}",
                  "body": {
                    "renderer": "icon",
                    "icon": "ChatLineRound",
                    "style": {
                      "transform": "translateY(-2px)"
                    }
                  }
                },
                {
                  "renderer": "html",
                  "html": "${('' + $.update_time).$format()}<h1 style=\"color: #ffb600;\">${data.confirmed_count}</h1>\n<div>confirmed_count</div>\n<h1 style=\"color: blue;\">${data.suspected_count}</h1>\n<div>suspected_count</div>\n<h1 style=\"color: green;\">${data.cured_count}</h1>\n<div>cured_count</div>\n<h1 style=\"color: red;\">${data.dead_count}</h1>\n<div>dead_count</div>"
                }
              ]
            }
          ]
        },
        {
          "renderer": "chart",
          "mapArea": "china",
          "initApi": {
            "url": "/api/mock/virus/province",
            "method": "get",
            "params": {
              "start_time": "${start_time}"
            }
          },
          "config": {
            "tooltip": {
              "trigger": "item"
            },
            "visualMap": {
              "min": 800,
              "max": 5000,
              "text": [
                "high",
                "low"
              ],
              "realtime": false,
              "calculable": true,
              "inRange": {
                "color": [
                  "#e6f7ff",
                  "#1890FF",
                  "#0050b3"
                ]
              }
            },
            "series": [
              {
                "type": "map",
                "map": "china",
                "name": "人数统计",
                "data": "${list}"
              }
            ]
          },
          "height": 570,
