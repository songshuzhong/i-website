      "innerStyle": ".cards {\n  margin-bottom: 30px;\n  .i-crud__container__pagination {\n    position: fixed;\n    bottom: calc(var(--i-admin-header-height) - 10px);\n    left: 0;\n    width: 100%;\n    padding: 0px 20px 0 20px;\n    background: var(--el-bg-color);\n  }\n}\n.crud-card {\n  .i-card__header {\n    display: flex;\n    align-items: center;\n    padding: 6px 20px;\n    background: var(--el-fill-color-lighter);\n  }\n  .i-card__body {\n    overflow: hidden;\n  }\n  &:hover {\n    background: transparent; \n border: 1px solid var(--el-color-primary);\n    box-shadow: 0 2px 10px 1px var(--el-color-primary-light-9);\n    .crud-card_header-right-body {\n      &>.el-button {\n        display: none;\n      }\n    }\n    .crud-card__header__actions {\n      display: block;\n    }\n  }\n}\n.crud-card_header-left {\n  width: 65%;\n  text-align: left;\n}\n.crud-card_header-right {\n  width: 35%;\n  text-align: right;\n  &>.el-button {\n    display: block;\n  }\n}\n.crud-card__header__actions {\n  display: none;\n}\n.crud-static {\n  margin-right: 20%;\n}\n.crud-progress {\n  position: absolute !important;\n  top: 0;\n  right: 0;\n  width: 20%;\n  padding-top: 20px;\n  text-align: center;\n  &:before {\n    position: absolute;\n    top: 50%;\n    left: 0;\n    width: 1px;\n    height: 80%;\n    content: \"\";\n    background: var(--el-border-color-lighter);\n    transform: translateY(-50%);\n  }\n  .i-mapping__container {\n    position: absolute;\n    bottom: 5px;\n    right: -27px;\n    width: 80px;\n    padding: 4px;\n    margin-right: 5px;\n    text-align: center;\n    color: white;\n    transform: rotateZ(-45deg);\n    &.primary {\n      background: var(--el-color-primary);\n    }\n    &.success {\n      background: var(--el-color-success);\n    }\n    &.danger {\n      background: var(--el-color-danger);\n    }\n    &.warning {\n      background: var(--el-color-warning);\n    }\n    .el-badge {\n      display: none;\n    }\n  }\n}\n  .i-mapping__container {\n    &.card {\n      position: absolute;\n      left: 0;\n      top: 0;\n      width: 100%;\n      height: 100%;\n      z-index: -1;\n      &.primary {\n        background: linear-gradient(180deg, transparent, var(--el-color-primary-light-9));\n      }\n      &.success {\n        background: linear-gradient(180deg, transparent, var(--el-color-success-light-9));\n      }\n      &.warning {\n        background: linear-gradient(180deg, transparent, var(--el-color-warning-light-9));\n      }\n      &.danger {\n        background: linear-gradient(180deg, transparent, var(--el-color-danger-light-9));\n      }\n      &.info {\n        background: linear-gradient(180deg, transparent, var(--el-color-info-light-9));\n      }\n    }\n  }"
