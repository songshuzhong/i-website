                  "params": {
                    "id": "${id}"
                  },
                  "type": "info",
                  "size": "small"
                },
                {
                  "renderer": "action",
                  "text": " ",
                  "category": "icon",
                  "icon": "QuestionFilled",
                  "popupType": "tip",
                  "tipContent": "${description}",
                  "body": {},
                  "size": 12,
                  "static": true
                }
              ],
              "body": [
                {
                  "renderer": "mapping",
                  "distributes": [
                    "type"
