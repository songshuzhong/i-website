            {
              "renderer": "action",
              "text": "返回",
              "type": "success",
              "actionType": "url",
              "url": "-1",
              "body": {},
              "plain": true
            },
            {
              "renderer": "action",
              "actionType": "extends",
              "text": "重置",
              "plain": true,
              "triggered": "reset"
            },
            {
              "renderer": "action",
              "actionType": "extends",
              "popupType": "dialog",
              "messageBoxExp": "1 === 1",
              "popoverTitle": "存在${valid}，确定提交吗？",
              "text": "确定",
              "body": {},
